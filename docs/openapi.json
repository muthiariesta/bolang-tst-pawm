  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItineraryIn": {
        "properties": {
          "place_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Place Ids",
            "examples": [
              [
                "curug-dago",
                "museum-geologi",
                "trans-studio-bandung"
              ]
            ]
          },
          "start_point": {
            "$ref": "#/components/schemas/Point"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date"
          },
          "days": {
            "type": "integer",
            "maximum": 7.0,
            "minimum": 1.0,
            "title": "Days",
            "default": 1
          },
          "travel_mode": {
            "type": "string",
            "enum": [
              "driving",
              "walking"
            ],
            "title": "Travel Mode",
            "default": "driving"
          },
          "day_start": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Day Start",
            "default": "08:00"
          },
          "max_hours": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Max Hours",
            "default": 10
          },
          "visit_min": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Visit Min",
            "description": "Ubah lama kunjungan per place_id (menit)"
          }
        },
        "type": "object",
        "required": [
          "place_ids",
          "start_point",
          "start_date"
        ],
        "title": "ItineraryIn"
      },
      "ItineraryPatch": {
        "properties": {
          "order": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order",
            "description": "Urutan baru place_ids (semua tempat)"
          },
          "locked": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locked",
            "description": "place_ids yang dikunci posisinya"
          },
          "visit_min": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              {
                "type": "null"
              }

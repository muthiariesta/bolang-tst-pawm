    "/api/weather": {
      "get": {
        "tags": [
          "route & weather"
        ],
        "summary": "Prakiraan cuaca harian (Open-Meteo, cache 30 menit)",
        "description": "Satu tanggal mengembalikan satu objek. Dengan `end_date`, hasilnya `{\"days\": [...]}`. Tanggal valid: hari ini sampai 15 hari ke depan (WIB). Di luar itu: 422 DATE_OUT_OF_RANGE.",
        "operationId": "get_weather_api_weather_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "examples": [
                -6.9211
              ],
              "title": "Lat"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "examples": [
                107.6094
              ],
              "title": "Lon"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "YYYY-MM-DD, WIB",
              "title": "Date"
            },
            "description": "YYYY-MM-DD, WIB"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opsional, untuk rentang beberapa hari",
              "title": "End Date"
            },
            "description": "Opsional, untuk rentang beberapa hari"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },

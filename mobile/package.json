{
  "name": "bolang-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "fix-deps": "expo install --fix",
    "test": "jest --watchAll",
    "test:ci": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.0",
    "@expo/vector-icons": "^15.0.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "expo": "~58.0.0",
    "expo-font": "~58.0.12",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.16.0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*-test.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg)"
    ]
  }
}
